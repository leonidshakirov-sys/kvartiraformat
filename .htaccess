Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On

# Keep private application directories inaccessible when the whole project is
# uploaded into Beget's public_html. Public assets and the front controller live
# in /public.
RewriteRule ^(app|config|database|docs|storage|tools)(/|$) - [F,L]
RewriteRule ^README\.md$ - [F,L]
RewriteRule ^\.git - [F,L]

RewriteCond %{REQUEST_URI} !^/public/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ public/$1 [L]

RewriteCond %{REQUEST_URI} !^/public/
RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f [OR]
RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -d
RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

